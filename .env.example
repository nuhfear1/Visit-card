# Launch phase: public production webhooks created in n8n.
# Credentials for CRM, email, AI and other tools remain inside n8n.
NEXT_PUBLIC_N8N_PROJECT_CONVERSATION_WEBHOOK_URL=
NEXT_PUBLIC_N8N_MASTERCLASS_REGISTRATION_WEBHOOK_URL=
NEXT_PUBLIC_N8N_EVENT_WEBHOOK_URL=

# Later phase: when configured, the backend becomes the public entry point
# and keeps n8n behind it as the orchestration layer.
NEXT_PUBLIC_API_BASE_URL=
