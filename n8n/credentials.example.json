{
  "notice": "Create these credentials in n8n, then bind them to the imported nodes. This file contains names and header types only, never secrets.",
  "credentials": [
    {
      "name": "GWB Event Ledger Postgres",
      "type": "postgres",
      "purpose": "Durable canonical event ledger and identity map"
    },
    {
      "name": "GWB HubSpot Private App",
      "type": "httpHeaderAuth",
      "header": "Authorization",
      "valueFormat": "Bearer <HUBSPOT_PRIVATE_APP_TOKEN>"
    },
    {
      "name": "GWB Brevo API",
      "type": "httpHeaderAuth",
      "header": "api-key",
      "valueFormat": "<BREVO_API_KEY>"
    },
    {
      "name": "GWB Webinar API",
      "type": "httpHeaderAuth",
      "header": "Authorization",
      "valueFormat": "Bearer <WEBINAR_API_TOKEN>"
    },
    {
      "name": "GWB OpenAI API",
      "type": "httpHeaderAuth",
      "header": "Authorization",
      "valueFormat": "Bearer <OPENAI_API_KEY>"
    },
    {
      "name": "GWB Internal Webhook Auth",
      "type": "httpHeaderAuth",
      "header": "X-GWB-Workflow-Key",
      "valueFormat": "<RANDOM_INTERNAL_SECRET>"
    }
  ]
}
